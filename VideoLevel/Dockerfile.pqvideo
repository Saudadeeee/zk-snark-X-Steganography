# Containerized Linux runtime for the native C/Python video pipeline.
# LaZer is built separately by lazer/Dockerfile because it needs Sage and an
# AVX-512-capable host at execution time.
FROM ubuntu@sha256:69cecf4bbf72d2d44a9eef1b71fb98c7fb973d78af11399deccef19beb008ad9

ARG DEBIAN_FRONTEND=noninteractive
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/workspace

RUN apt-get update && apt-get install --yes --no-install-recommends \
    ca-certificates cmake ffmpeg g++ gcc make nodejs python3 python3-dev python3-pip && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY requirements.lock ./
RUN python3 -m pip install --break-system-packages --requirement requirements.lock

COPY . ./
RUN cmake -S native -B native/build -DCMAKE_BUILD_TYPE=Release && \
    cmake --build native/build --parallel && \
    chmod 0755 /workspace/docker/pqvideo-entrypoint.sh

RUN useradd --create-home --uid 10001 zkstego && \
    chown -R zkstego:zkstego /workspace
USER zkstego

ENTRYPOINT ["/workspace/docker/pqvideo-entrypoint.sh"]
CMD ["test"]
