# Test outputs
*.json
!circuits/package.json
!circuits/package-lock.json
!benchmark/results/realtime_camera_*.json
!benchmark/results/*_new.json
!benchmark/results/*_new.pdf
!benchmark/results/media_new/
!benchmark/results/media_new/**/
!benchmark/results/media_new/**/video_pipeline_new.json
!benchmark/results/media_new/**/quality_per_frame_new.csv
# Encoded/stego streams of a media run are regenerated by the suite; keep them local.
benchmark/results/media_new/**/*.h264
benchmark/results/zkp_new/
# The repository-root .gitignore ignores test_*.py; re-include real test suites
# so new tests are never silently left out of commits.
!src/runtest/test_*.py
!benchmark/test_*.py
!output/
!output/pdf/
!output/pdf/zk_stego_theoretical_foundation.pdf

# Temporary files
*.tmp
*.bak
.cache/
.pytest_cache/
native/edge-build/
native/cavlc-build/

benchmark_*/

# Benchmark cache artifacts
benchmark/results/_idr_cache_*.pkl
benchmark/results/_proof_payload_cache.bin

# Debug & scratch scripts
debug_*.py
tmp*.py
check_*.py
*_output.txt
tmpclaude-*/
tmpclaude-*-cwd

# Local demo executions contain per-run keys and generated media.
demo/runs/
demo/native_walkthrough/runs/

# Intermediate document-generation workspaces; keep final files under output/.
.build-presentation/
.chart-data-*/
.codex-finalizer/
