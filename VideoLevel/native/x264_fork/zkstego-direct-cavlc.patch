diff --git a/encoder/zkstego.h b/encoder/zkstego.h
new file mode 100644
--- /dev/null
+++ b/encoder/zkstego.h
@@ -0,0 +1,12 @@
+#ifndef X264_ZKSTEGO_H
+#define X264_ZKSTEGO_H
+
+#include "../common/common.h"
+
+void x264_zkstego_begin_macroblock( x264_t *h );
+void x264_zkstego_try_embed_4x4( x264_t *h, dctcoef coefficients[16] );
+void x264_zkstego_commit_macroblock( x264_t *h );
+void x264_zkstego_abort_macroblock( x264_t *h );
+void x264_zkstego_clear( x264_t *h );
+
+#endif
diff --git a/encoder/zkstego.c b/encoder/zkstego.c
new file mode 100644
--- /dev/null
+++ b/encoder/zkstego.c
@@ -0,0 +1,62 @@
+#include "zkstego.h"
+
+static const uint8_t zigzag4_frame_to_dct[16] =
+{ 0, 4, 1, 2, 5, 8, 12, 9, 6, 3, 7, 10, 13, 14, 11, 15 };
+
+static unsigned int magnitude( dctcoef coefficient )
+{
+    return coefficient < 0 ? (unsigned int)-(int)coefficient : (unsigned int)coefficient;
+}
+
+void x264_zkstego_clear( x264_t *h )
+{
+    if( h )
+    {
+        memset( &h->zkstego, 0, sizeof(h->zkstego) );
+    }
+}
+
+void x264_zkstego_begin_macroblock( x264_t *h )
+{
+    h->zkstego.armed = h->param.zkstego_payload && h->zkstego.next_bit < h->param.zkstego_payload_size * 8;
+    h->zkstego.staged = 0;
+}
+
+void x264_zkstego_try_embed_4x4( x264_t *h, dctcoef coefficients[16] )
+{
+    int bit_index;
+    int target_bit;
+    if( !h->zkstego.armed || h->zkstego.staged )
+        return;
+    bit_index = h->zkstego.next_bit;
+    target_bit = (h->param.zkstego_payload[bit_index >> 3] >> (7 - (bit_index & 7))) & 1;
+    for( int scan_index = 15; scan_index > 0; scan_index-- )
+    {
+        int coefficient_index = zigzag4_frame_to_dct[scan_index];
+        dctcoef coefficient = coefficients[coefficient_index];
+        unsigned int absolute = magnitude( coefficient );
+        if( absolute < 4 )
+            continue;
+        if( (absolute & 1) != target_bit )
+            coefficients[coefficient_index] += coefficient < 0 ? -1 : 1;
+        h->zkstego.staged = 1;
+        return;
+    }
+}
+
+void x264_zkstego_commit_macroblock( x264_t *h )
+{
+    if( h->zkstego.staged )
+    {
+        h->zkstego.next_bit++;
+        h->zkstego.embedded_bits++;
+    }
+    h->zkstego.armed = 0;
+    h->zkstego.staged = 0;
+}
+
+void x264_zkstego_abort_macroblock( x264_t *h )
+{
+    h->zkstego.armed = 0;
+    h->zkstego.staged = 0;
+}
