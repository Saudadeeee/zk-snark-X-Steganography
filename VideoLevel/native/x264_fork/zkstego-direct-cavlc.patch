diff --git a/encoder/zkstego.c b/encoder/zkstego.c
new file mode 100644
index 0000000..d3d4a5a
--- /dev/null
+++ b/encoder/zkstego.c
@@ -0,0 +1,73 @@
+#include "zkstego.h"
+
+static unsigned int magnitude( dctcoef coefficient )
+{
+    return coefficient < 0 ? (unsigned int)-(int)coefficient : (unsigned int)coefficient;
+}
+
+void x264_zkstego_clear( x264_t *h )
+{
+    if( h )
+    {
+        memset( &h->zkstego, 0, sizeof(h->zkstego) );
+    }
+}
+
+void x264_zkstego_begin_macroblock( x264_t *h )
+{
+    h->zkstego.armed = h->param.zkstego_payload && h->zkstego.next_bit < h->param.zkstego_payload_size * 8;
+    h->zkstego.staged = 0;
+}
+
+void x264_zkstego_try_embed_4x4( x264_t *h, dctcoef coefficients[16], int block_index )
+{
+    int bit_index;
+    int target_bit;
+    int coefficient_index;
+    /* x264's quantized dct4x4 buffer is transposed: its zigzag scan uses
+     * dct[x*4+y], not the conventional row-major raster index y*4+x. */
+    static const uint8_t scan4x4_dct[16] =
+        { 0, 4, 1, 2, 5, 8, 12, 9, 6, 3, 7, 10, 13, 14, 11, 15 };
+    if( !h->zkstego.armed || h->zkstego.staged )
+        return;
+    /* Intra I4x4 is eligible in IDR and P pictures; inter residual carriers
+     * are limited to explicitly enabled P pictures. */
+    if( ( h->sh.i_type == SLICE_TYPE_I && h->mb.i_type != I_4x4 ) ||
+        ( h->sh.i_type == SLICE_TYPE_P && !h->param.zkstego_allow_inter_picture_carriers ) ||
+        ( h->sh.i_type != SLICE_TYPE_I && h->sh.i_type != SLICE_TYPE_P ) ||
+        ( h->sh.i_type == SLICE_TYPE_P && IS_INTRA( h->mb.i_type ) && h->mb.i_type != I_4x4 ) ||
+        block_index < 0 || block_index >= 16 )
+        return;
+    bit_index = h->zkstego.next_bit;
+    target_bit = (h->param.zkstego_payload[bit_index >> 3] >> (7 - (bit_index & 7))) & 1;
+    for( coefficient_index = 15; coefficient_index > 0; coefficient_index-- )
+    {
+        int dct_index = scan4x4_dct[coefficient_index];
+        dctcoef coefficient = coefficients[dct_index];
+        unsigned int absolute = magnitude( coefficient );
+        if( absolute < 5 )
+            continue;
+        /* Preserve eligibility so blind scan order remains reproducible. */
+        if( (absolute & 1) != target_bit )
+            coefficients[dct_index] += coefficient < 0 ? -1 : 1;
+        h->zkstego.staged = 1;
+        return;
+    }
+}
+
+void x264_zkstego_commit_macroblock( x264_t *h )
+{
+    if( h->zkstego.staged )
+    {
+        h->zkstego.next_bit++;
+        h->zkstego.embedded_bits++;
+    }
+    h->zkstego.armed = 0;
+    h->zkstego.staged = 0;
+}
+
+void x264_zkstego_abort_macroblock( x264_t *h )
+{
+    h->zkstego.armed = 0;
+    h->zkstego.staged = 0;
+}
